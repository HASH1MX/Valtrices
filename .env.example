# Valtrices - local environment. Copy this file to `.env` (which is git-ignored).
#
# Vite reads VITE_* variables at build time and compiles them into the frontend
# bundle, so only put values here that are safe to ship inside a desktop app.
#
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...) or the legacy "anon" key. Both are designed
# to be public and are protected by Row Level Security on the database.
# NEVER put the service_role / secret key in this file or anywhere in the app.
VITE_SUPABASE_PUBLISHABLE_KEY=
